<% const itemId = (item) => item.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, ""); %>
<% const featuredPick = page.items[0]; %>
<% const quickPicks = page.items.slice(0, 3); %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= page.metaTitle || `${page.title} | Phavai` %></title>
  <meta name="description" content="<%= page.metaDescription || page.description %>" />
  <% if (page.indexable === false) { %><meta name="robots" content="noindex,follow" /><% } else { %><meta name="robots" content="max-image-preview:large" /><% } %>
  <link rel="canonical" href="https://www.phavai.com/<%= page.slug %>.html" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= page.metaTitle || `${page.title} | Phavai` %>" />
  <meta property="og:description" content="<%= page.metaDescription || page.description %>" />
  <meta property="og:image" content="https://www.phavai.com/photos/generated/phavai-running-gear-social.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= page.metaTitle || `${page.title} | Phavai` %>" />
  <meta name="twitter:description" content="<%= page.metaDescription || page.description %>" />
  <meta name="twitter:image" content="https://www.phavai.com/photos/generated/phavai-running-gear-social.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="/affiliate-tracking.js" defer></script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": page.title,
    "description": page.description,
    "url": `https://www.phavai.com/${page.slug}.html`,
    "dateModified": page.dateModified,
    "publisher": {
      "@type": "Organization",
      "name": "Phavai",
      "url": "https://www.phavai.com/"
    },
    "hasPart": page.items.map((item) => ({
      "@type": "WebPageElement",
      "name": item.name,
      "description": item.summary
    }))
  }, null, 2) %>
  </script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.phavai.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": page.title,
        "item": `https://www.phavai.com/${page.slug}.html`
      }
    ]
  }, null, 2) %>
  </script>
</head>
<body>
  <header class="site-header">
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href="/index.html"><span class="brand-mark">P</span> Phavai</a>
      <div class="nav-links">
        <% allSections.forEach((item) => { %>
          <a href="/<%= item.slug %>.html"><%= item.title %></a>
        <% }) %>
        <a href="/<%= page.slug %>.html">Today's Picks</a>
        <a class="hide-small" href="/methodology.html">Methodology</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="page-hero todays-hero">
      <div class="wrap">
        <a class="crumb" href="/index.html">Phavai / <%= page.eyebrow %></a>
        <h1><%= page.title %></h1>
        <p class="lede"><%= page.intro %></p>
        <div class="meta-row" aria-label="Page details">
          <span class="meta-pill">Updated <%= page.updated %></span>
          <span class="meta-pill"><%= page.items.length %> quick picks</span>
          <span class="meta-pill">Retail links never buy placement</span>
        </div>
        <% if (featuredPick) { %>
          <section class="quick-answer-panel" aria-labelledby="quick-answer-heading" data-quick-answer>
            <div class="quick-answer-main">
              <div class="section-kicker">Quick answer</div>
              <h2 id="quick-answer-heading">Start with <a href="#<%= itemId(featuredPick) %>"><%= featuredPick.name %></a>.</h2>
              <p><%= featuredPick.summary %></p>
              <div class="quick-answer-facts" aria-label="Why this pick leads">
                <span><strong>#1</strong> today's pick</span>
                <span><strong><%= featuredPick.retailer %></strong> retailer</span>
                <span><strong>0</strong> paid placement</span>
              </div>
            </div>
            <div class="quick-answer-proof">
              <div>
                <span>Best for</span>
                <p><%= featuredPick.bestFor %></p>
              </div>
              <div>
                <span>Watch-out</span>
                <p><%= featuredPick.watchOut %></p>
              </div>
              <div>
                <span>Why it leads</span>
                <p><%= featuredPick.kicker %></p>
              </div>
            </div>
            <div class="quick-answer-actions">
              <p class="inline-affiliate-disclosure">Phavai may earn a commission from qualifying purchases, at no extra cost to you.</p>
              <a class="button shopping-button" href="<%= featuredPick.url %>" target="_blank" rel="sponsored noopener" aria-label="<%= featuredPick.buttonLabel %> for <%= featuredPick.name %>" data-product-cta data-affiliate-link data-retailer="<%= featuredPick.retailer %>" data-guide="<%= page.title %>" data-section="Today's Picks" data-product-name="<%= featuredPick.name %>" data-product-rank="1" data-product-score="" data-shopping-label="<%= featuredPick.buttonLabel %>" data-shopping-placement="todays-picks-quick-answer"><%= featuredPick.buttonLabel %></a>
              <a class="button secondary" href="#<%= itemId(featuredPick) %>">Read why</a>
              <p>Compare seller, size, color, current price, and return terms before checkout.</p>
            </div>
          </section>
          <% if (quickPicks.length > 1) { %>
            <div class="quick-pick-strip" aria-label="Fast comparison of today's picks">
              <% quickPicks.forEach((item, index) => { %>
                <a href="#<%= itemId(item) %>">
                  <span>Pick #<%= index + 1 %></span>
                  <strong><%= item.name %></strong>
                  <small><%= item.kicker %></small>
                </a>
              <% }) %>
            </div>
          <% } %>
        <% } %>
      </div>
    </section>

    <section class="band">
      <div class="wrap todays-layout">
        <div class="todays-list">
          <% page.items.forEach((item, index) => { %>
            <article class="today-pick-card" id="<%= itemId(item) %>">
              <div class="today-pick-visual today-pick-visual--<%= item.icon %>" aria-hidden="true">
                <% if (item.icon === "tea") { %>
                  <svg viewBox="0 0 64 64"><path d="M18 25h28v15a12 12 0 0 1-24 0V25Z"/><path d="M46 30h4a6 6 0 0 1 0 12h-4"/><path d="M25 15c-3 4 3 5 0 9m8-9c-3 4 3 5 0 9m8-9c-3 4 3 5 0 9"/></svg>
                <% } else if (item.icon === "leaf") { %>
                  <svg viewBox="0 0 64 64"><path d="M15 45c20 0 31-13 34-31-19 2-34 12-34 31Z"/><path d="M18 44c8-10 17-17 28-24"/><path d="M24 37c-3-6-2-12 2-18"/></svg>
                <% } else if (item.icon === "supplement") { %>
                  <svg viewBox="0 0 64 64"><path d="M20 14h24l5 10v34H15V24l5-10Z"/><path d="M20 14h24M23 30h18M25 40h14"/><path d="M25 53c6-5 13-5 18 0"/></svg>
                <% } else { %>
                  <svg viewBox="0 0 64 64"><rect x="18" y="9" width="28" height="46" rx="5"/><rect x="22" y="14" width="20" height="34" rx="2"/><path d="M29 51h6"/></svg>
                <% } %>
              </div>
              <div class="today-pick-body">
                <div class="product-badge-row">
                  <span class="rank-badge">Pick #<%= index + 1 %></span>
                  <span class="decision-badge"><%= item.kicker %></span>
                </div>
                <h2><%= item.name %></h2>
                <p class="decision-summary"><%= item.summary %></p>
                <div class="mini-decision-grid" aria-label="Quick decision notes for <%= item.name %>">
                  <div>
                    <span>Best for</span>
                    <p><%= item.bestFor %></p>
                  </div>
                  <div>
                    <span>Double-check</span>
                    <p><%= item.watchOut %></p>
                  </div>
                </div>
                <div class="shopping-button-group" aria-label="Shopping options for <%= item.name %>">
                  <a class="button shopping-button" href="<%= item.url %>" target="_blank" rel="sponsored noopener" data-product-cta data-affiliate-link data-retailer="<%= item.retailer %>" data-guide="<%= page.title %>" data-section="Today's Picks" data-product-name="<%= item.name %>" data-product-rank="<%= index + 1 %>" data-product-score="" data-shopping-label="<%= item.buttonLabel %>"><%= item.buttonLabel %></a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
        <aside class="sidebar">
          <h2>How to use this page</h2>
          <p>Today's Picks is a lighter page for useful finds, not a full BestPick roundup. Check product details, seller, size, color, and current price before checkout.</p>
          <p class="disclosure affiliate-disclosure">As an Amazon Associate I earn from qualifying purchases.</p>
          <p class="disclosure">Retail links never buy placement on Phavai.</p>
          <div class="link-list compact">
            <a href="/lifestyle.html"><span>More Lifestyle guides</span><span>Hub</span></a>
            <a href="/best-coffee-makers.html"><span>Best Coffee Makers</span><span>Guide</span></a>
            <a href="/best-creatine.html"><span>Best Creatine</span><span>Guide</span></a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div>Phavai helps shoppers buy with fewer tabs, fewer regrets, and better evidence.</div>
      <div>
        <a href="/index.html">Home</a>
        <% allSections.forEach((item) => { %>
          <a href="/<%= item.slug %>.html"><%= item.title %></a>
        <% }) %>
        <a href="/<%= page.slug %>.html">Today's Picks</a>
        <a href="/methodology.html">Methodology</a>
        <a href="/about.html">About</a>
        <a href="/contact.html">Contact</a>
        <a href="/privacy.html">Privacy</a>
        <a href="/terms.html">Terms</a>
      </div>
    </div>
  </footer>
</body>
</html>
