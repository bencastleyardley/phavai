<%
const summary = dashboard.summary || {};
const topPages = dashboard.topPages || [];
const topSearchPages = dashboard.topSearchPages || [];
const topProducts = dashboard.topProducts || [];
const tasks = maintenanceQueue.tasks || [];
const systems = dashboard.systems || [];
const searchPerformance = dashboard.searchPerformance || {};
const siteSearch = searchPerformance.site_summary || {};
const firstSearchWindow = searchPerformance.first_28_days || {};
const latestSearchWindow = searchPerformance.latest_28_days || {};
const commercePerformance = dashboard.commercePerformance || {};
const ga4 = commercePerformance.ga4 || {};
const amazon = commercePerformance.amazon || {};
const pageMovements = dashboard.pageMovements || [];
const experiments = searchExperiments?.experiments || [];
const visiblePages = [...(topSearchPages.length ? topSearchPages : topPages)]
  .filter((page) => Number(page.searchSignal?.impressions || 0) > 0)
  .sort((a, b) => Number(b.searchSignal?.impressions || 0) - Number(a.searchSignal?.impressions || 0));
const generatedDate = dashboard.generatedAt ? new Date(dashboard.generatedAt) : null;
const generatedLabel = generatedDate && !Number.isNaN(generatedDate.getTime())
  ? generatedDate.toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" })
  : "Not generated yet";
const formatNumber = (value) => Number(value || 0).toLocaleString("en-US");
const formatPercent = (value, digits = 1) => Number.isFinite(Number(value)) ? `${(Number(value) * 100).toFixed(digits)}%` : "—";
const formatMoney = (value) => Number.isFinite(Number(value)) ? Number(value).toLocaleString("en-US", { style: "currency", currency: "USD" }) : "—";
const statusLabel = (status) => ({
  ready: "Ready",
  "needs-attention": "Needs attention",
  "needs-data": "Needs data"
}[status] || status || "Review");
const priorityLabel = (priority) => ({
  high: "High",
  medium: "Medium",
  low: "Low"
}[priority] || "Review");
const summaryItems = [
  { label: "Pages tracked", value: summary.pages, note: "roundup buying guides" },
  { label: "Product placements", value: summary.productPlacements, note: "ranked products in guides" },
  { label: "Affiliate ready", value: summary.readyAffiliateProducts, note: "Amazon-ready placements" },
  { label: "High-priority tasks", value: summary.highPriorityTasks, note: "start here this week" },
  { label: "Unique products", value: summary.uniqueProducts, note: "deduped product names" },
  { label: "Missing YouTube", value: summary.productsMissingYouTube, note: "video evidence gaps" },
  { label: "Missing Reddit", value: summary.productsMissingReddit, note: "owner discussion gaps" },
  { label: "Missing expert", value: summary.productsMissingExpert, note: "cited hands-on source gaps" }
];
%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AI Growth Dashboard | Phavai</title>
  <meta name="description" content="Private Phavai operator dashboard for product evidence, affiliate readiness, and growth maintenance." />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="canonical" href="https://www.phavai.com/operator-dashboard.html" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="site-header">
    <nav class="nav" aria-label="Private dashboard navigation">
      <a class="brand" href="/index.html"><span class="brand-mark">P</span> Phavai</a>
      <div class="nav-links">
        <% allSections.forEach((item) => { %>
          <a href="/<%= item.slug %>.html"><%= item.title %></a>
        <% }) %>
        <a href="/todays-picks.html">Today's Picks</a>
        <a class="hide-small" href="/methodology.html">Methodology</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="page-hero operator-hero">
      <div class="wrap">
        <a class="crumb" href="/index.html">Phavai / Private ops</a>
        <h1>AI growth dashboard</h1>
        <p class="lede">A private queue for turning source gaps, affiliate readiness, and revenue pages into a repeatable weekly operating loop.</p>
        <div class="meta-row" aria-label="Dashboard details">
          <span class="meta-pill">Generated <%= generatedLabel %></span>
          <span class="meta-pill"><%= formatNumber(tasks.length) %> maintenance tasks</span>
          <span class="meta-pill">Noindex operator page</span>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="operator-kpi-grid" aria-label="Product intelligence summary">
          <% summaryItems.forEach((item) => { %>
            <div class="operator-kpi">
              <span><%= item.label %></span>
              <strong><%= formatNumber(item.value) %></strong>
              <small><%= item.note %></small>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="band surface">
      <div class="wrap">
        <div class="section-kicker">Monthly performance</div>
        <h2>Search and commerce snapshot</h2>
        <p class="operator-section-copy">Search Console and GA4 are loaded from the latest exports. Amazon orders and earnings remain blank until a Tracking ID report covering the same dates is imported.</p>
        <div class="performance-kpi-grid" aria-label="Search and commerce metrics">
          <article><span>GSC impressions</span><strong><%= formatNumber(siteSearch.impressions) %></strong><small><%= siteSearch.start || "—" %> to <%= siteSearch.end || "—" %></small></article>
          <article><span>GSC clicks</span><strong><%= formatNumber(siteSearch.clicks) %></strong><small><%= formatPercent(siteSearch.ctr, 2) %> search CTR</small></article>
          <article><span>Average position</span><strong><%= Number.isFinite(Number(siteSearch.position)) ? Number(siteSearch.position).toFixed(1) : "—" %></strong><small>sitewide export average</small></article>
          <article><span>Retailer clicks</span><strong><%= ga4.status === "imported" ? formatNumber(ga4.outboundRetailerClicks) : "—" %></strong><small><%= ga4.status === "imported" ? `${formatPercent(ga4.clickUserRate || (ga4.activeUsers ? ga4.clickUsers / ga4.activeUsers : 0))} of users clicked` : "GA4 export needed" %></small></article>
          <article><span>Amazon orders</span><strong><%= amazon.status === "imported" ? formatNumber(amazon.itemsOrdered) : "—" %></strong><small><%= amazon.status === "imported" ? `${formatNumber(amazon.clicks)} Amazon clicks` : "matched-period report needed" %></small></article>
          <article><span>Amazon earnings</span><strong><%= amazon.status === "imported" ? formatMoney(amazon.totalEarnings) : "—" %></strong><small><%= amazon.status === "imported" ? `${formatMoney(amazon.orderedRevenue)} ordered revenue` : "not estimated from clicks" %></small></article>
        </div>

        <div class="performance-detail-grid">
          <section class="performance-panel" aria-labelledby="search-trend-heading">
            <div class="section-kicker">Sitewide trend</div>
            <h3 id="search-trend-heading">First and latest 28-day windows</h3>
            <div class="trend-comparison">
              <div><span>First 28 days</span><strong><%= formatNumber(firstSearchWindow.impressions) %> impressions</strong><small><%= formatNumber(firstSearchWindow.clicks) %> clicks · <%= Number(firstSearchWindow.position || 0).toFixed(1) %> position</small></div>
              <div><span>Latest 28 days</span><strong><%= formatNumber(latestSearchWindow.impressions) %> impressions</strong><small><%= formatNumber(latestSearchWindow.clicks) %> clicks · <%= Number(latestSearchWindow.position || 0).toFixed(1) %> position</small></div>
            </div>
            <p><strong><%= Number(searchPerformance.impression_change_pct || 0).toFixed(1) %>%</strong> impression change and <strong><%= Number(searchPerformance.click_change_pct || 0).toFixed(1) %>%</strong> click change between those sitewide windows. Low click volume makes the click percentage volatile.</p>
          </section>
          <section class="performance-panel" aria-labelledby="commerce-heading">
            <div class="section-kicker">Conversion baseline</div>
            <h3 id="commerce-heading"><%= commercePerformance.period?.label || "Current export" %></h3>
            <div class="trend-comparison">
              <div><span>GA4 pageviews</span><strong><%= ga4.status === "imported" ? formatNumber(ga4.pageViews) : "—" %></strong><small><%= ga4.status === "imported" ? `${formatNumber(ga4.sessions)} sessions · ${formatNumber(ga4.activeUsers)} users` : "No GA4 snapshot" %></small></div>
              <div><span>Users who clicked</span><strong><%= ga4.status === "imported" ? formatPercent(ga4.clickUserRate || (ga4.activeUsers ? ga4.clickUsers / ga4.activeUsers : 0)) : "—" %></strong><small><%= ga4.status === "imported" ? `${formatNumber(ga4.clickUsers)} of ${formatNumber(ga4.activeUsers)} users` : "No GA4 snapshot" %></small></div>
              <div><span>Product-level split</span><strong><%= ga4.productBreakdownAvailable ? "Available" : "Starts next cycle" %></strong><small><%= ga4.productBreakdownAvailable ? "Guide and product dimensions imported" : "New custom dimensions do not backfill" %></small></div>
            </div>
            <p><%= ga4.note || amazon.note || "Import matched reports before using this panel for revenue decisions." %></p>
          </section>
        </div>

        <div class="comparison-scroll performance-table-wrap">
          <table class="comparison-table operator-table">
            <thead><tr><th>Page</th><th>Impressions</th><th>Clicks</th><th>CTR</th><th>Position</th><th>Next move</th></tr></thead>
            <tbody>
              <% visiblePages.slice(0, 10).forEach((page) => { %>
                <tr>
                  <td><a href="/<%= page.page %>.html"><%= page.title %></a></td>
                  <td><%= formatNumber(page.searchSignal.impressions) %></td>
                  <td><%= formatNumber(page.searchSignal.clicks) %></td>
                  <td><%= formatPercent(page.searchSignal.ctr, 2) %></td>
                  <td><%= Number(page.searchSignal.position || 0).toFixed(1) %></td>
                  <td><%= page.recommendedActions?.[0] || "Monitor monthly." %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <section class="movement-panel" aria-labelledby="movement-heading">
          <div><div class="section-kicker">Page movement</div><h3 id="movement-heading">Pages gaining or losing visibility</h3></div>
          <% if (pageMovements.length) { %>
            <div class="movement-list"><% pageMovements.forEach((page) => { %><div><strong><%= page.title %></strong><span><%= page.impressionChange > 0 ? "+" : "" %><%= page.impressionChange %> impressions · <%= page.positionChange > 0 ? "+" : "" %><%= page.positionChange %> positions</span></div><% }) %></div>
          <% } else { %>
            <p>The current Search Console file establishes the first page-level baseline. Import the next monthly export to calculate honest per-page gains and losses; the dashboard will not infer movement from one snapshot.</p>
          <% } %>
        </section>

        <div class="growth-control-grid">
          <section class="measurement-action-panel" aria-labelledby="experiment-heading">
            <div class="section-kicker">Search experiments</div>
            <h3 id="experiment-heading">Protect clean measurement windows</h3>
            <% if (experiments.length) { %>
              <div class="experiment-list">
                <% experiments.forEach((experiment) => { %>
                  <article>
                    <span><%= experiment.status.replaceAll("-", " ") %></span>
                    <strong><a href="/<%= experiment.page %>.html"><%= experiment.pageTitle %></a></strong>
                    <small>Started <%= experiment.startedAt %> · review no earlier than <%= experiment.reviewAfter %></small>
                    <p><%= experiment.decisionRule %></p>
                  </article>
                <% }) %>
              </div>
            <% } else { %>
              <p>No title or snippet test is currently logged.</p>
            <% } %>
          </section>
          <section class="measurement-action-panel" aria-labelledby="analytics-setup-heading">
            <div class="section-kicker">Measurement setup</div>
            <h3 id="analytics-setup-heading">Finish placement attribution</h3>
            <p>Keep <strong>outbound_retailer_click</strong> as the single retailer-click event and only key event. Register these two event-scoped custom dimensions next:</p>
            <ul>
              <li><code>cta_placement</code> — quick answer, fit finder, comparison, product card, or final recommendation</li>
              <li><code>site_section</code> — Outdoor, Remote Work, Lifestyle, or Today's Picks</li>
            </ul>
            <p>Do not assign a default dollar value to a click. Use Amazon order and earnings reports for revenue.</p>
          </section>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap operator-dashboard-grid">
        <div class="operator-main">
          <div class="section-kicker">Page opportunities</div>
          <h2>Highest leverage pages</h2>
          <p class="operator-section-copy">These pages combine source gaps, revenue-page weighting, freshness, and affiliate status into one work queue.</p>
          <div class="comparison-scroll">
            <table class="comparison-table operator-table">
              <thead>
                <tr>
                  <th>Page</th>
                  <th>Score</th>
                  <th>Gap</th>
                  <th>Evidence</th>
                  <th>Next action</th>
                </tr>
              </thead>
              <tbody>
                <% topPages.slice(0, 12).forEach((page) => { %>
                  <tr>
                    <td><a href="/<%= page.page %>.html"><%= page.title %></a><br /><span><%= page.section %> / <%= page.dataSource %></span></td>
                    <td><strong><%= page.opportunityScore %></strong></td>
                    <td><%= page.sourceGapTotal %> source gaps<br /><span><%= page.affiliateIssues %> affiliate issues</span></td>
                    <td><%= page.averageEvidenceCount %> avg sources<br /><span><%= page.sourceCompleteProducts %>/<%= page.productCount %> complete</span></td>
                    <td><%= page.recommendedActions?.[0] || "Review manually." %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="section-kicker operator-gap">Product opportunities</div>
          <h2>Products to strengthen next</h2>
          <div class="comparison-scroll">
            <table class="comparison-table operator-table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Score</th>
                  <th>Affiliate</th>
                  <th>Evidence</th>
                  <th>Recommended action</th>
                </tr>
              </thead>
              <tbody>
                <% topProducts.slice(0, 12).forEach((product) => { %>
                  <tr>
                    <td><a href="/<%= product.page %>.html"><%= product.product %></a><br /><span><%= product.pageTitle %></span></td>
                    <td><strong><%= product.opportunityScore %></strong></td>
                    <td><%= product.affiliateStatus.replaceAll("_", " ") %></td>
                    <td>
                      <%= product.evidenceCounts.total %> total<br />
                      <span><%= product.evidenceCounts.expert %> expert, <%= product.evidenceCounts.youtube %> video, <%= product.evidenceCounts.reddit %> owner</span>
                    </td>
                    <td><%= product.recommendedActions?.[0] || "Review manually." %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <aside class="operator-sidebar" aria-label="Maintenance queue">
          <div class="section-kicker">Maintenance queue</div>
          <h2>This week's queue</h2>
          <ol class="operator-task-list">
            <% tasks.slice(0, 16).forEach((task) => { %>
              <li class="operator-task operator-priority--<%= task.priority %>">
                <div>
                  <span class="operator-priority"><%= priorityLabel(task.priority) %></span>
                  <strong><a href="/<%= task.page %>.html"><%= task.product %></a></strong>
                  <small><%= task.page %> / score <%= task.opportunityScore %></small>
                </div>
                <p><%= task.action %></p>
                <% if (task.followUps?.length) { %>
                  <ul>
                    <% task.followUps.slice(0, 2).forEach((followUp) => { %>
                      <li><%= followUp %></li>
                    <% }) %>
                  </ul>
                <% } %>
              </li>
            <% }) %>
          </ol>
        </aside>
      </div>
    </section>

    <section class="band surface">
      <div class="wrap">
        <div class="operator-system-grid">
          <% systems.forEach((system) => { %>
            <article class="operator-system operator-status--<%= system.status %>">
              <span><%= statusLabel(system.status) %></span>
              <h3><%= system.name %></h3>
              <p><%= system.nextStep %></p>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap page-grid">
        <div>
          <div class="section-kicker">Operating loop</div>
          <h2>Weekly AI-assisted workflow</h2>
          <p class="operator-section-copy">Use this loop to keep the site improving while the public pages stay evidence-first and commercially clean.</p>
        </div>
        <div class="operator-command-list" aria-label="Recurring commands">
          <div><code>npm run growth:audit</code><span>Refresh source, affiliate, and product intelligence reports.</span></div>
          <div><code>npm run performance:import -- --ga-events &lt;file&gt; --amazon-tracking &lt;file&gt; --start YYYY-MM-DD --end YYYY-MM-DD</code><span>Load matched GA4 and Amazon reports for the monthly conversion snapshot.</span></div>
          <div><code>npm run build &amp;&amp; npm run quality:audit &amp;&amp; npm run seo:audit</code><span>Build and run the non-browser quality checks.</span></div>
          <div><code>npm run deploy</code><span>Regenerate the queue, build, and ship production through Vercel.</span></div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div>Private Phavai operator dashboard. Keep public rankings evidence-led and affiliate links separate from editorial decisions.</div>
      <div>
        <a href="/index.html">Home</a>
        <a href="/todays-picks.html">Today's Picks</a>
        <a href="/methodology.html">Methodology</a>
      </div>
    </div>
  </footer>
</body>
</html>
