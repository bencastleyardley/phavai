<% const pageImage = socialImage || image || products[0].image; %>
<% const ogImage = pageImage.startsWith("http") ? pageImage : `https://www.phavai.com${pageImage}`; %>
<% const affiliateEnabled = Boolean(affiliateConfig?.affiliateEnabled); %>
<% const productId = (product) => product.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, ""); %>
<% const quickWinner = products[0]; %>
<% const winnerShoppingLink = quickWinner?.shoppingLinks?.[0]; %>
<% const quickPicks = [quickWinner, decisionSnapshot?.bestValue, decisionSnapshot?.useCasePick].filter(Boolean).filter((product, index, list) => list.findIndex((item) => item.name === product.name) === index).slice(0, 3); %>
<% const fitOptions = (decisionOptions || []).slice(0, 4); %>
<% const hasCatalogImages = products.some((product) => Boolean(product.catalogImage)); %>
<% const fitProfileFor = (product) => {
  const id = productId(product);
  const shoppingLink = product.shoppingLinks?.[0];
  return {
    id,
    name: product.name,
    rank: product.rank,
    defaultScore: product.bestPickScore,
    publicScoreLabel: product.publicScoreLabel,
    tag: product.tag,
    bestFor: product.bestFor,
    avoidIf: product.avoidIf,
    biggestStrength: product.biggestStrength,
    biggestComplaint: product.biggestComplaint,
    decisionTags: product.decisionTags || [],
    attributeGraph: product.attributeGraph || {},
    shoppingUrl: shoppingLink?.url || product.affiliateUrl,
    shoppingLabel: shoppingLink?.displayLabel || shoppingLink?.label || "Check price",
    retailerName: shoppingLink?.retailerName || product.retailerName || "Retailer"
  };
}; %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= metaTitle || `${title} | Phavai` %></title>
  <meta name="description" content="<%= metaDescription || description %>" />
  <meta name="robots" content="max-image-preview:large" />
  <link rel="canonical" href="https://www.phavai.com/<%= slug %>.html" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content="<%= metaTitle || `${title} | Phavai` %>" />
  <meta property="og:description" content="<%= metaDescription || description %>" />
  <meta property="og:image" content="<%= ogImage %>" />
  <% if (socialImage) { %><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="675" /><% } %>
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= metaTitle || `${title} | Phavai` %>" />
  <meta name="twitter:description" content="<%= metaDescription || description %>" />
  <meta name="twitter:image" content="<%= ogImage %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="/affiliate-tracking.js" defer></script>
  <script src="/fit-finder.js" defer></script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": metaDescription || description,
    "image": ogImage,
    "datePublished": datePublished,
    "dateModified": dateModified,
    "author": {
      "@type": "Person",
      "@id": editorialProfile.id,
      "name": editorialProfile.name,
      "url": editorialProfile.id,
      "jobTitle": editorialProfile.role,
      "knowsAbout": editorialProfile.knowsAbout || []
    },
    "publisher": {
      "@type": "Organization",
      "name": "Phavai",
      "url": "https://www.phavai.com/"
    },
    "mainEntityOfPage": `https://www.phavai.com/${slug}.html`,
    "about": section.title,
    "mentions": products.map((product) => product.name)
  }, null, 2) %>
  </script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": schemaName,
    "description": description,
    "itemListElement": products.map((product) => ({
      "@type": "ListItem",
      "position": product.rank,
      "name": product.name,
      "url": `https://www.phavai.com/${slug}.html#${product.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`
    }))
  }, null, 2) %>
  </script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.phavai.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": section.title,
        "item": `https://www.phavai.com/${section.slug}.html`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": title,
        "item": `https://www.phavai.com/${slug}.html`
      }
    ]
  }, null, 2) %>
  </script>
</head>
<body>
  <header class="site-header">
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href="/index.html"><span class="brand-mark">P</span> Phavai</a>
      <div class="nav-links">
        <% allSections.forEach((item) => { %>
          <a href="/<%= item.slug %>.html"><%= item.title %></a>
        <% }) %>
        <a href="/todays-picks.html">Today's Picks</a>
        <a class="hide-small" href="/methodology.html">Methodology</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="page-hero">
      <div class="wrap">
        <a class="crumb" href="/<%= section.slug %>.html">Phavai / <%= section.title %> / <%= eyebrow %></a>
        <h1><%= title %></h1>
        <p class="lede"><%= (typeof lede !== "undefined" && lede) || `Shopping for ${title.toLowerCase()} gets messy fast. Phavai uses AI-assisted research to organize recurring pros, cons, specifications, and buyer feedback so the tradeoffs are easier to see.` %></p>
        <div class="meta-row" aria-label="Page details">
          <span class="meta-pill">Last updated <%= updated %></span>
          <span class="meta-pill">Sources checked <%= sourcesVerifiedAt %></span>
          <span class="meta-pill"><%= audience %></span>
          <span class="meta-pill">Retail links never buy rank</span>
        </div>
        <p class="review-byline">AI-assisted research by Phavai · Reviewed by <a href="<%= editorialProfile.path %>"><%= editorialProfile.name %></a>, <%= editorialProfile.expertiseSections.includes(section.slug) ? editorialProfile.outdoorByline : editorialProfile.generalByline %>. We synthesize selected public sources and do not claim hands-on testing unless it is documented. <a href="/methodology.html">How it works</a>.</p>
        <% if (quickWinner) { %>
          <section class="quick-answer-panel" aria-labelledby="quick-answer-heading" data-quick-answer>
            <div class="quick-answer-main">
              <div class="section-kicker">Quick answer</div>
              <h2 id="quick-answer-heading">Start with <a href="#<%= productId(quickWinner) %>"><%= quickWinner.name %></a>.</h2>
              <p><%= quickWinner.decisionSummary %></p>
              <div class="quick-answer-facts" aria-label="Why this pick leads">
                <span><strong><%= quickWinner.publicScoreLabel %></strong> BestPick</span>
                <span><strong>#<%= quickWinner.rank %></strong> guide rank</span>
                <span><strong><%= quickWinner.sourceScores.length %></strong> proof channels</span>
              </div>
            </div>
            <div class="quick-answer-proof">
              <div>
                <span>Best for</span>
                <p><%= quickWinner.bestFor %></p>
              </div>
              <div>
                <span>Watch-out</span>
                <p><%= quickWinner.biggestComplaint %></p>
              </div>
              <div>
                <span>Best proof</span>
                <p><%= quickWinner.sourceProofSummary %></p>
              </div>
            </div>
            <div class="quick-answer-actions">
              <% const quickLink = quickWinner.shoppingLinks?.[0]; %>
              <% if (affiliateEnabled && quickLink) { %>
                <p class="inline-affiliate-disclosure">Phavai may earn a commission from qualifying purchases, at no extra cost to you.</p>
                <a class="button shopping-button" href="<%= quickLink.url %>" target="_blank" rel="sponsored noopener" aria-label="<%= quickLink.displayLabel || quickLink.label || "Check price" %> for <%= quickWinner.name %>" data-product-cta data-affiliate-link data-retailer="<%= quickLink.retailerName || "Retailer" %>" data-guide="<%= title %>" data-section="<%= section.title %>" data-product-name="<%= quickWinner.name %>" data-product-rank="<%= quickWinner.rank %>" data-product-score="<%= quickWinner.bestPickScore %>" data-shopping-label="<%= quickLink.displayLabel || quickLink.label || "Check price" %>" data-shopping-placement="quick-answer"><%= quickLink.displayLabel || quickLink.label || "Check price" %></a>
              <% } %>
              <a class="button secondary" href="#<%= productId(quickWinner) %>" data-view-details data-product-name="<%= quickWinner.name %>" data-guide="<%= title %>">Read why</a>
              <p>Compare size, color, seller, and return terms before checkout.</p>
            </div>
          </section>
          <% if (quickPicks.length > 1) { %>
            <div class="quick-pick-strip" aria-label="Fast comparison of top picks">
              <% quickPicks.forEach((product) => { %>
                <a href="#<%= productId(product) %>">
                  <span>#<%= product.rank %></span>
                  <strong><%= product.name %></strong>
                  <small><%= product.tag %></small>
                </a>
              <% }) %>
            </div>
          <% } %>
        <% } %>
        <% if (fitOptions.length && products.length > 1) { %>
          <section class="fit-finder" data-fit-finder data-fit-options="<%- encodeURIComponent(JSON.stringify(fitOptions)) %>" aria-labelledby="fit-finder-heading">
            <div class="fit-finder-copy">
              <div class="section-kicker">Find your fit</div>
              <h2 id="fit-finder-heading">Match this guide to your priorities</h2>
              <p>Choose up to two buying priorities. Phavai keeps the editorial ranking intact and highlights the product that best fits your situation.</p>
            </div>
            <div class="fit-finder-controls">
              <div class="fit-chip-row" role="group" aria-label="Buyer priorities">
                <% fitOptions.forEach((option) => { %>
                  <button class="fit-chip" type="button" data-fit-option="<%= option.key %>" aria-pressed="false">
                    <span><%= option.label %></span>
                    <small><%= option.help %></small>
                  </button>
                <% }) %>
                <button class="fit-chip fit-chip--clear" type="button" data-fit-clear aria-pressed="false">
                  <span>Reset</span>
                  <small>Return to editorial order</small>
                </button>
              </div>
              <div class="fit-result" data-fit-result aria-live="polite">
                <span data-fit-result-label>Choose a priority</span>
                <strong data-fit-result-name><%= quickWinner?.name || "Top pick" %></strong>
                <p data-fit-result-reason>Start with the editorial winner, or select priorities above to get a buyer-specific match from the same evidence.</p>
                <% if (quickWinner) { %>
                  <div class="fit-result-actions">
                    <a href="#<%= productId(quickWinner) %>" data-fit-result-link>Jump to current pick</a>
                    <% if (affiliateEnabled && winnerShoppingLink) { %>
                      <a class="button shopping-button fit-result-shop" href="<%= winnerShoppingLink.url %>" target="_blank" rel="sponsored noopener" hidden aria-label="Check price for your fit match, <%= quickWinner.name %>" data-fit-result-shop data-product-cta data-affiliate-link data-retailer="<%= winnerShoppingLink.retailerName || "Retailer" %>" data-guide="<%= title %>" data-section="<%= section.title %>" data-product-name="<%= quickWinner.name %>" data-product-rank="<%= quickWinner.rank %>" data-product-score="<%= quickWinner.bestPickScore %>" data-shopping-label="<%= winnerShoppingLink.displayLabel || winnerShoppingLink.label || "Check price" %>" data-shopping-placement="fit-finder">Check price for this match</a>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
            <div class="fit-match-grid" data-fit-match-grid aria-label="Fit match shortlist">
              <% products.slice(0, 3).forEach((product, index) => { %>
                <a class="fit-match-card" href="#<%= productId(product) %>" data-fit-card>
                  <span data-fit-card-rank>#<%= index + 1 %> editorial</span>
                  <strong data-fit-card-name><%= product.name %></strong>
                  <small data-fit-card-reason><%= product.tag %></small>
                </a>
              <% }) %>
            </div>
          </section>
        <% } %>

        <section class="comparison-section comparison-section--priority" aria-labelledby="comparison-heading">
          <div class="section-kicker">Compare before you scroll</div>
          <h2 id="comparison-heading">Top picks at a glance</h2>
          <p id="comparison-intro"><%= (typeof comparisonIntro !== "undefined" && comparisonIntro) || "Use this table to compare the ranking, ideal buyer, and practical skip-if notes before opening the detailed evidence for each product." %></p>
          <% if (!hasCatalogImages) { %>
            <div class="image-free-shopping-note">
              <strong>No retailer photos shown here.</strong>
              <span>Use the fit and tradeoff notes to narrow your choice, then confirm the exact model, seller, size or color, current price, and returns at the retailer.</span>
            </div>
          <% } %>
          <div class="comparison-scroll">
            <table class="comparison-table" aria-describedby="comparison-intro">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Pick</th>
                  <th>Price &amp; options</th>
                  <th>Best for</th>
                  <th>Main tradeoff</th>
                </tr>
              </thead>
              <tbody>
                <% products.forEach((product) => { %>
                  <tr>
                    <td>#<%= product.rank %></td>
                    <td><a href="#<%= productId(product) %>"><%= product.name %></a></td>
                    <td class="comparison-shop-cell">
                      <% if (affiliateEnabled && product.shoppingLinks?.length) { %>
                        <div class="shopping-button-group shopping-button-group--compact comparison-shopping-links" aria-label="Shopping options for <%= product.name %>">
                          <% product.shoppingLinks.forEach((link) => { %>
                            <a class="button shopping-button" href="<%= link.url %>" target="_blank" rel="sponsored noopener" aria-label="<%= link.displayLabel || link.label || "Check price" %> for <%= product.name %>" data-product-cta data-affiliate-link data-retailer="<%= link.retailerName || "Retailer" %>" data-guide="<%= title %>" data-section="<%= section.title %>" data-product-name="<%= product.name %>" data-product-rank="<%= product.rank %>" data-product-score="<%= product.bestPickScore %>" data-shopping-label="<%= link.displayLabel || link.label || "Check price" %>" data-shopping-placement="comparison"><%= link.displayLabel || link.label || "Check price" %></a>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <a class="comparison-details-link" href="#<%= productId(product) %>">Read the evidence</a>
                      <% } %>
                    </td>
                    <td><%= product.bestFor %></td>
                    <td><%= product.avoidIf %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>

        <% if (typeof flagshipResearch !== "undefined" && flagshipResearch) { %>
          <section class="research-brief" aria-labelledby="research-brief-heading">
            <div class="research-brief__heading">
              <div>
                <div class="section-kicker"><%= flagshipResearch.eyebrow %></div>
                <h2 id="research-brief-heading"><%= flagshipResearch.title %></h2>
              </div>
              <span class="research-brief__stamp">Checked <%= flagshipResearch.updated %></span>
            </div>
            <p class="research-brief__summary"><%= flagshipResearch.summary %></p>
            <% if (flagshipResearch.resourceLinks?.length) { %>
              <div class="research-resource-links" aria-label="Related research tools">
                <% flagshipResearch.resourceLinks.forEach((link) => { %><a href="<%= link.url %>"><%= link.label %></a><% }) %>
              </div>
            <% } %>
            <% if (flagshipResearch.keyFindings?.length) { %>
              <div class="research-finding-grid">
                <% flagshipResearch.keyFindings.forEach((finding) => { %>
                  <article>
                    <strong><%= finding.title %></strong>
                    <p><%= finding.body %></p>
                  </article>
                <% }) %>
              </div>
            <% } %>
            <div class="research-table-scroll">
              <table class="research-table">
                <thead>
                  <tr>
                    <% flagshipResearch.columns.forEach((column) => { %><th><%= column %></th><% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% flagshipResearch.rows.forEach((row) => { %>
                    <tr>
                      <% row.forEach((cell, index) => { %>
                        <% if (index === 0) { %><th scope="row"><%= cell %></th><% } else { %><td><%= cell %></td><% } %>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (flagshipResearch.decisionGuide?.length) { %>
              <div class="research-decision-grid">
                <% flagshipResearch.decisionGuide.forEach((decision) => { %>
                  <article>
                    <span><%= decision.scenario %></span>
                    <strong>Start with <%= decision.start %></strong>
                    <p><%= decision.reason %></p>
                    <% if (decision.caution) { %><small><%= decision.caution %></small><% } %>
                  </article>
                <% }) %>
              </div>
            <% } %>
            <div class="research-source-panel">
              <div>
                <h3>How this audit was built</h3>
                <ul>
                  <% flagshipResearch.method.forEach((item) => { %><li><%= item %></li><% }) %>
                </ul>
              </div>
              <div>
                <h3>Primary product documents</h3>
                <div class="research-source-links">
                  <% flagshipResearch.sources.forEach((source) => { %>
                    <a href="<%= source.url %>" target="_blank" rel="noopener"><%= source.label %><span>Open source</span></a>
                  <% }) %>
                </div>
              </div>
            </div>
            <p class="research-limitations"><strong>Limits:</strong> <%= flagshipResearch.limitations %></p>
          </section>
        <% } %>
      </div>
    </section>

    <section class="band">
      <div class="wrap ranking-layout">
        <div class="content-column">
          <div data-product-list>
          <% products.forEach((product) => { const id = productId(product); %>
            <article class="product" id="<%= id %>" data-product-name="<%= product.name %>" data-default-score="<%= product.bestPickScore %>" data-editorial-rank="<%= product.rank %>" data-channel-scores='<%- JSON.stringify(Object.fromEntries(product.sourceScores.map((row) => [row.source, row.score]))) %>' data-decision-tags='<%- JSON.stringify(product.decisionTags || []) %>' data-decision-graph='<%- JSON.stringify(product.attributeGraph || {}) %>' data-fit-profile="<%- encodeURIComponent(JSON.stringify(fitProfileFor(product))) %>">
              <div class="product-media product-media--<%= section.slug %> product-visual--<%= product.visualKind %> product-visual--<%= product.visualVariant %>">
                <% if (product.catalogImage) { %>
                  <img src="<%= product.catalogImage.url %>" alt="<%= product.name %>" width="<%= product.catalogImage.width || 500 %>" height="<%= product.catalogImage.height || 500 %>" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                <% } else { %>
                  <div class="product-visual-frame" role="img" aria-label="Brand-neutral illustration representing <%= product.name %>, <%= product.visualRole %>">
                    <span class="product-visual-icon" aria-hidden="true"><%- product.visualSvg %></span>
                  </div>
                <% } %>
              </div>
              <div>
                <div class="product-badge-row">
                  <span class="rank-badge">Rank <span data-rank>#<%= product.rank %></span></span>
                  <% product.decisionBadges?.forEach((badge) => { %>
                    <span class="decision-badge"><%= badge %></span>
                  <% }) %>
                  <span class="recommended-badge" data-recommended-badge hidden>Recommended for you</span>
                </div>
                <h2><%= product.name %></h2>
                <div class="tagline"><%= product.tag %></div>
                <p class="decision-summary"><%= product.decisionSummary %></p>

                <div class="score-stack" aria-label="Phavai score summary for <%= product.name %>">
                  <div class="score-box score-box--primary <%= product.sourceScores.length ? "" : "score-box--pending" %>"><strong><%= product.publicScoreLabel %></strong><span>BestPick Score</span></div>
                  <% if (product.sourceScores.length) { %>
                    <div class="product-signal-grid" aria-label="Scoring signals for <%= product.name %>">
                      <% product.sourceScores.forEach((row) => { const scoreSources = row.displaySources || []; %>
                        <div class="product-signal product-signal--<%= row.source.toLowerCase() %>">
                          <div class="signal-score-head">
                            <span><%= row.source %></span>
                            <strong><%= row.score %></strong>
                            <small><%= row.source %> Score</small>
                          </div>
                          <% if (scoreSources.length) { %>
                            <div class="signal-source-list">
                              <div class="signal-source-row">
                                <span>Best evidence</span>
                                <a href="<%= scoreSources[0].url %>" target="_blank" rel="nofollow noopener" data-source-link data-source-type="<%= scoreSources[0].sourceLabel %>" data-source-title="<%= scoreSources[0].title || scoreSources[0].sourceName %>" data-product-name="<%= product.name %>" data-guide="<%= title %>"><%= scoreSources[0].scorecardLabel %></a>
                              </div>
                              <% if (scoreSources.length > 1) { %>
                                <div class="signal-source-row">
                                  <span>Also used</span>
                                  <p>
                                    <% scoreSources.slice(1).forEach((item, sourceIndex, sourceList) => { %>
                                      <a href="<%= item.url %>" target="_blank" rel="nofollow noopener" data-source-link data-source-type="<%= item.sourceLabel %>" data-source-title="<%= item.title || item.sourceName %>" data-product-name="<%= product.name %>" data-guide="<%= title %>"><%= item.scorecardLabel %></a><% if (sourceIndex < sourceList.length - 1) { %>, <% } %>
                                    <% }) %>
                                  </p>
                                </div>
                              <% } %>
                            </div>
                          <% } %>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </div>

                <div class="mini-decision-grid" aria-label="Quick decision notes for <%= product.name %>">
                  <div>
                    <span>Best for</span>
                    <p><%= product.bestFor %></p>
                  </div>
                  <div>
                    <span>Avoid if</span>
                    <p><%= product.avoidIf %></p>
                  </div>
                  <div>
                    <span>Key tradeoff</span>
                    <p><%= product.biggestComplaint %></p>
                  </div>
                </div>

                <div class="proof-snapshot-grid" aria-label="Proof snapshot for <%= product.name %>">
                  <div>
                    <span>Proof base</span>
                    <strong><%= product.evidenceCount %> public source<%= product.evidenceCount === 1 ? "" : "s" %></strong>
                    <p><%= product.sourceScores.map((row) => row.source).join(", ") || "Source review in progress" %></p>
                  </div>
                  <div>
                    <span>Freshness</span>
                    <strong><%= product.recencyStrength %>/100</strong>
                    <p>Recent page updates and public source recency support this read.</p>
                  </div>
                  <div>
                    <span>Buyer warning</span>
                    <strong><%= product.attributeGraph?.confidenceLevel || "Reviewing" %> proof</strong>
                    <p><%= product.biggestComplaint %></p>
                  </div>
                </div>

                <% if (product.modelFreshness) { %>
                  <div class="freshness-note">
                    <span><%= product.modelFreshness.status %></span>
                    <p><%= product.modelFreshness.note %></p>
                  </div>
                <% } %>

                <% if (affiliateEnabled) { %>
                  <div class="shopping-button-group" aria-label="Shopping options for <%= product.name %>">
                    <% ;(product.shoppingLinks?.length ? product.shoppingLinks : [{ label: "Check price", displayLabel: `Check price at ${product.retailerName || "Retailer"}`, url: product.affiliateUrl, retailerName: product.retailerName }]).forEach((link) => { %>
                      <a class="button shopping-button" href="<%= link.url %>" target="_blank" rel="sponsored noopener" data-product-cta data-affiliate-link data-retailer="<%= link.retailerName || "Retailer" %>" data-guide="<%= title %>" data-section="<%= section.title %>" data-product-name="<%= product.name %>" data-product-rank="<%= product.rank %>" data-product-score="<%= product.bestPickScore %>" data-shopping-label="<%= link.displayLabel || link.label || "Check price" %>" data-shopping-placement="product-card"><%= link.displayLabel || link.label || "Check price" %></a>
                    <% }) %>
                  </div>
                <% } else { %>
                  <span class="button shopping-button shopping-button--pending disabled" role="status" aria-disabled="true" data-product-cta data-shopping-pending data-guide="<%= title %>" data-section="<%= section.title %>" data-product-name="<%= product.name %>" data-product-rank="<%= product.rank %>" data-product-score="<%= product.bestPickScore %>">Shopping link not active yet</span>
                <% } %>

                  <details class="evidence-drawer" data-source-dropdown data-source-type="all" data-product-name="<%= product.name %>" data-guide="<%= title %>">
                    <summary>
                      <span>View full evidence</span>
                      <small>Upside, cautions, and proof</small>
                    </summary>
                    <div class="evidence-drawer-body">
                      <% if (product.evidenceSummary.likes.groups.length) { %>
                        <section class="evidence-panel like-panel">
                          <div class="source-section-label">What people like</div>
                          <p><%= product.evidenceSummary.likes.interpretation %></p>
                          <% product.evidenceSummary.likes.groups.forEach((group) => { %>
                            <div class="source-group">
                              <h3><%= group.label %></h3>
                              <div class="source-link-list">
                                <% group.sources.forEach((item, sourceIndex) => { %>
                                  <a class="source-link <%= sourceIndex === 0 && item.is_primary_source ? 'best-source' : '' %>" href="<%= item.url %>" target="_blank" rel="nofollow noopener" data-source-link data-source-type="<%= item.sourceLabel %>" data-source-title="<%= item.title || item.sourceName %>" data-product-name="<%= product.name %>" data-guide="<%= title %>">
                                    <span><%= item.sourceLabel %><% if (sourceIndex === 0 && item.is_primary_source) { %> / Best evidence<% } %></span>
                                    <b><%= item.title || item.sourceName %></b>
                                    <small><%= item.publisher %><% if (item.author) { %> by <%= item.author %><% } %> - checked <%= item.verifiedAt %></small>
                                    <% if (item.evidence_note || item.summary) { %><em><%= item.evidence_note || item.summary %></em><% } %>
                                  </a>
                                <% }) %>
                              </div>
                            </div>
                          <% }) %>
                        </section>
                      <% } else { %>
                        <section class="evidence-panel like-panel">
                          <div class="source-section-label">What people like</div>
                          <p><%= product.evidenceSummary.likes.interpretation %></p>
                          <div class="source-review-note">Public source links for this upside are still being tightened. Phavai keeps weak search, listing, and barely related links off the page.</div>
                        </section>
                      <% } %>

                      <% if (product.evidenceSummary.cautions.groups.length) { %>
                        <section class="evidence-panel caution-panel">
                          <div class="source-section-label">What people caution</div>
                          <p><%= product.evidenceSummary.cautions.interpretation %></p>
                          <% product.evidenceSummary.cautions.groups.forEach((group) => { %>
                            <div class="source-group">
                              <h3><%= group.label %></h3>
                              <div class="source-link-list">
                                <% group.sources.forEach((item) => { %>
                                  <a class="source-link" href="<%= item.url %>" target="_blank" rel="nofollow noopener" data-source-link data-source-type="<%= item.sourceLabel %>" data-source-title="<%= item.title || item.sourceName %>" data-product-name="<%= product.name %>" data-guide="<%= title %>">
                                    <span><%= item.sourceLabel %></span>
                                    <b><%= item.title || item.sourceName %></b>
                                    <small><%= item.publisher %><% if (item.author) { %> by <%= item.author %><% } %> - checked <%= item.verifiedAt %></small>
                                    <% if (item.evidence_note || item.summary) { %><em><%= item.evidence_note || item.summary %></em><% } %>
                                  </a>
                                <% }) %>
                              </div>
                            </div>
                          <% }) %>
                        </section>
                      <% } else { %>
                        <section class="evidence-panel caution-panel">
                          <div class="source-section-label">What people caution</div>
                          <p><%= product.evidenceSummary.cautions.interpretation %></p>
                          <div class="source-review-note">Public caution links are under manual review. We do not show weak owner mentions as proof.</div>
                        </section>
                      <% } %>
                    </div>
                  </details>
              </div>
            </article>
          <% }) %>
          </div>

          <% if (faqs?.length) { %>
          <section class="faq-section" aria-labelledby="faq-heading">
            <div class="section-kicker">Buying questions</div>
            <h2 id="faq-heading"><%= title %> FAQ</h2>
            <div class="faq-list">
              <% faqs.forEach((faq) => { %>
                <details>
                  <summary><%= faq.question %></summary>
                  <p><%= faq.answer %></p>
                </details>
              <% }) %>
            </div>
          </section>
          <% } %>

          <% if (finalRecommendation) { %>
          <section class="final-panel" aria-labelledby="final-heading">
            <div class="section-kicker">Final recommendation</div>
            <h2 id="final-heading">What most shoppers should do</h2>
            <p><%= finalRecommendation %></p>
            <% if (affiliateEnabled && quickWinner && winnerShoppingLink) { %>
              <div class="final-shop-panel">
                <div>
                  <span>Current top pick</span>
                  <strong><%= quickWinner.name %></strong>
                  <small><%= quickWinner.biggestStrength %> Confirm the exact model, seller, current price, and return terms before checkout.</small>
                </div>
                <div class="final-shop-actions">
                  <a class="button shopping-button" href="<%= winnerShoppingLink.url %>" target="_blank" rel="sponsored noopener" aria-label="<%= winnerShoppingLink.displayLabel || winnerShoppingLink.label || "Check price" %> for <%= quickWinner.name %>" data-product-cta data-affiliate-link data-retailer="<%= winnerShoppingLink.retailerName || "Retailer" %>" data-guide="<%= title %>" data-section="<%= section.title %>" data-product-name="<%= quickWinner.name %>" data-product-rank="<%= quickWinner.rank %>" data-product-score="<%= quickWinner.bestPickScore %>" data-shopping-label="<%= winnerShoppingLink.displayLabel || winnerShoppingLink.label || "Check price" %>" data-shopping-placement="final-recommendation"><%= winnerShoppingLink.displayLabel || winnerShoppingLink.label || "Check price" %></a>
                  <a class="button secondary" href="#comparison-heading">Compare all picks</a>
                </div>
                <p class="inline-affiliate-disclosure">Phavai may earn a commission from qualifying purchases, at no extra cost to you.</p>
              </div>
            <% } %>
          </section>
          <% } %>

          <% if (relatedReviews?.length) { %>
          <section class="comparison-section" aria-labelledby="related-heading">
            <div class="section-kicker">Related <%= section.title %> guides</div>
            <h2 id="related-heading">Keep comparing in <%= section.title %></h2>
            <p>Most buying decisions are connected. These nearby guides help you compare the adjacent choice before you commit.</p>
            <div class="link-list">
              <a href="/<%= section.slug %>.html"><span>Back to <%= section.title %></span><span>Category hub</span></a>
              <% relatedReviews.slice(0, 5).forEach((review) => { %>
                <a href="/<%= review.slug %>.html"><span><%= review.title %></span><span>Review guide</span></a>
              <% }) %>
            </div>
          </section>
          <% } %>

          <% if (supportingPages?.length) { %>
          <section class="comparison-section" aria-labelledby="supporting-heading">
            <div class="section-kicker">Buying context</div>
            <h2 id="supporting-heading">Learn how to choose with confidence</h2>
            <p>Use these guides to understand the tradeoffs before you compare products: fit, features, durability, comfort, and the mistakes worth avoiding.</p>
            <div class="link-list">
              <% supportingPages.slice(0, 4).forEach((page) => { %>
                <a href="/<%= page.slug %>.html"><span><%= page.title %></span><span><%= page.type %></span></a>
              <% }) %>
            </div>
          </section>
          <% } %>
          <% if (affiliateEnabled) { %>
            <p class="disclosure affiliate-disclosure guide-bottom-disclosure">As an Amazon Associate I earn from qualifying purchases. Retail links never affect Phavai rankings.</p>
          <% } else { %>
            <p class="disclosure commercial-disclosure guide-bottom-disclosure">Shopping links are not active yet. Retail links never affect Phavai rankings.</p>
          <% } %>
        </div>

        <aside class="sidebar" aria-label="Ranking summary">
          <h2>How to read this guide</h2>
          <p>The top pick is our editorial default. The page keeps the winner, tradeoffs, and best proof close together, so you can decide faster without treating the ranking as one-size-fits-all.</p>
          <p>Open the source dropdowns when you want the proof behind a score. Product order is editorial and retail links stay separate from evidence.</p>
          <h3>Guide order</h3>
          <% products.forEach((product) => { %>
            <div class="mini-rank" data-mini-rank="<%= product.name %>">
              <span>#<%= product.rank %> <%= product.name %></span>
              <strong><%= product.publicScoreLabel %></strong>
            </div>
          <% }) %>
          <div class="editorial-card">
            <h3>Editorial standards</h3>
            <p>Phavai keeps shopping links separate from product order and shows the evidence behind each recommendation.</p>
            <a href="/editorial-standards.html">Read our standards</a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div>AI-assisted product research. Human-reviewed. Sources linked.</div>
      <div>
        <a href="/index.html">Home</a>
        <% allSections.forEach((item) => { %>
          <a href="/<%= item.slug %>.html"><%= item.title %></a>
        <% }) %>
        <a href="/todays-picks.html">Today's Picks</a>
        <a href="/methodology.html">Methodology</a>
        <a href="/about.html">About</a>
        <a href="/contact.html">Contact</a>
        <a href="/privacy.html">Privacy</a>
        <a href="/terms.html">Terms</a>
      </div>
    </div>
  </footer>
</body>
</html>
