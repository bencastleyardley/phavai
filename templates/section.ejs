<% const ogImage = section.image.startsWith("http") ? section.image : `https://www.phavai.com${section.image}`; %>
<% const featuredReview = coreReviews[0] || reviews[0]; %>
<% const featuredProduct = featuredReview?.products?.[0]; %>
<% const featuredLink = featuredProduct?.shoppingLinks?.[0]; %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= section.metaTitle || `${section.title} Buying Guides | Phavai` %></title>
  <meta name="description" content="<%= section.metaDescription || section.description %>" />
  <meta name="robots" content="max-image-preview:large" />
  <link rel="canonical" href="https://www.phavai.com/<%= section.slug %>.html" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= section.metaTitle || `${section.title} Buying Guides | Phavai` %>" />
  <meta property="og:description" content="<%= section.description %>" />
  <meta property="og:image" content="<%= ogImage %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= section.metaTitle || `${section.title} Buying Guides | Phavai` %>" />
  <meta name="twitter:description" content="<%= section.description %>" />
  <meta name="twitter:image" content="<%= ogImage %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="/affiliate-tracking.js" defer></script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": section.metaTitle || `${section.title} Buying Guides | Phavai`,
    "description": section.description,
    "url": `https://www.phavai.com/${section.slug}.html`,
    "publisher": {
      "@type": "Organization",
      "@id": "https://www.phavai.com/#organization",
      "name": "Phavai",
      "url": "https://www.phavai.com/"
    },
    "hasPart": reviews.map((review) => ({
      "@type": "Article",
      "headline": review.title,
      "url": `https://www.phavai.com/${review.slug}.html`
    }))
  }, null, 2) %>
  </script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.phavai.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": section.title,
        "item": `https://www.phavai.com/${section.slug}.html`
      }
    ]
  }, null, 2) %>
  </script>
</head>
<body>
  <header class="site-header">
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href="/index.html"><span class="brand-mark">P</span> Phavai</a>
      <div class="nav-links">
        <% allSections.forEach((item) => { %>
          <a href="/<%= item.slug %>.html"><%= item.title %></a>
        <% }) %>
        <a href="/todays-picks.html">Today's Picks</a>
        <a class="hide-small" href="/methodology.html">Methodology</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="page-hero section-hero">
      <div class="wrap">
        <div class="page-grid">
          <div>
            <a class="crumb" href="/index.html">Phavai / <%= section.title %></a>
            <h1><%= section.title %> Buying Guides</h1>
            <p class="lede"><%= section.intro %></p>
            <div class="meta-row">
              <span class="meta-pill">Buyer-first picks</span>
              <span class="meta-pill"><%= reviews.length %> live buying guides</span>
              <span class="meta-pill">Retail links never buy rank</span>
            </div>
            <p class="review-byline">AI-assisted research · Human review by <a href="<%= editorialProfile.path %>"><%= editorialProfile.name %></a><% if (editorialProfile.expertiseSections.includes(section.slug)) { %>, <%= editorialProfile.outdoorByline %><% } %>. Phavai organizes selected reviews, recurring tradeoffs, and product facts; it does not imply first-hand testing. <a href="/methodology.html">See the process</a>.</p>
          </div>
          <% if (featuredReview) { %>
          <section class="quick-answer-panel quick-answer-panel--lean" aria-labelledby="quick-answer-heading" data-quick-answer>
            <div class="quick-answer-main">
              <div class="section-kicker">Quick answer</div>
              <h2 id="quick-answer-heading">Start with <a href="/<%= featuredReview.slug %>.html"><%= featuredReview.title %></a>.</h2>
              <p><%= featuredReview.description %></p>
            </div>
            <div class="quick-answer-actions">
              <a class="button" href="/<%= featuredReview.slug %>.html">Open buying guide</a>
              <% if (affiliateConfig?.affiliateEnabled && featuredProduct && featuredLink) { %>
                <p class="inline-affiliate-disclosure">Phavai may earn a commission from qualifying purchases, at no extra cost to you.</p>
                <a class="button secondary shopping-button supporting-retailer-button" href="<%= featuredLink.url %>" target="_blank" rel="sponsored noopener" aria-label="<%= featuredLink.displayLabel || featuredLink.label || "Check price" %> for <%= featuredProduct.name %>" data-product-cta data-affiliate-link data-retailer="<%= featuredLink.retailerName || "Retailer" %>" data-guide="<%= featuredReview.title %>" data-section="<%= section.title %>" data-product-name="<%= featuredProduct.name %>" data-product-rank="<%= featuredProduct.rank %>" data-product-score="<%= featuredProduct.bestPickScore %>" data-shopping-label="<%= featuredLink.displayLabel || featuredLink.label || "Check price" %>" data-shopping-placement="section-quick-answer"><%= featuredLink.displayLabel || featuredLink.label || "Check price" %></a>
              <% } %>
            </div>
          </section>
          <% } else { %>
            <div class="section-icon section-icon--<%= section.slug %>" aria-hidden="true"><%- section.iconSvg %></div>
          <% } %>
        </div>
      </div>
    </section>

    <section class="band" id="guides">
      <div class="wrap">
        <div class="section-head">
          <h2><%= section.title %> buying guides</h2>
          <p>Start with the polished roundup closest to what you are buying. These are the core guides Phavai is keeping sharp first.</p>
        </div>
        <div class="category-grid icon-card-grid">
          <% coreReviews.forEach((review) => { %>
            <a class="category-card category-card--<%= section.slug %>" href="/<%= review.slug %>.html">
              <span class="card-icon" aria-hidden="true"><%- review.iconSvg %></span>
              <div class="category-card-body">
                <span class="eyebrow">Roundup guide</span>
                <h3><%= review.title %></h3>
                <p><%= review.description %></p>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>

    <% if (section.matters?.length) { %>
    <section class="band">
      <div class="wrap">
        <div class="section-head">
          <h2>What matters when you shop <%= section.title %>.</h2>
          <p>The best choice usually comes down to a few practical questions, not a spec sheet arms race.</p>
        </div>
        <div class="signal-grid">
          <% section.matters.forEach((item) => { %>
            <div class="signal">
              <b><%= item.heading %></b>
              <p><%= item.body %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (focusedReviews.length) { %>
    <section class="band surface" id="focused-guides">
      <div class="wrap">
        <div class="section-head">
          <h2>Focused <%= section.title.toLowerCase() %> guides</h2>
          <p>Use these narrower shortlists when your terrain, fit, distance, or buying situation needs a more specific answer.</p>
        </div>
        <div class="category-grid icon-card-grid">
          <% focusedReviews.forEach((review) => { %>
            <a class="category-card category-card--<%= section.slug %>" href="/<%= review.slug %>.html">
              <span class="card-icon" aria-hidden="true"><%- review.iconSvg %></span>
              <div class="category-card-body">
                <span class="eyebrow">Focused roundup</span>
                <h3><%= review.title %></h3>
                <p><%= review.description %></p>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (supportingPages.length) { %>
    <section class="band" id="shopping-advice">
      <div class="wrap">
        <div class="section-head">
          <h2><%= section.title %> shopping advice</h2>
          <p>Start here when you need to understand the decision before comparing individual products.</p>
        </div>
        <div class="category-grid">
          <% supportingPages.forEach((page) => { %>
            <a class="category-card category-card--<%= section.slug %>" href="/<%= page.slug %>.html">
              <div class="category-card-body">
                <span class="eyebrow"><%= page.type %></span>
                <h3><%= page.title %></h3>
                <p><%= page.description %></p>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div>AI-assisted product research. Human-reviewed. Sources linked.</div>
      <div>
        <a href="/index.html">Home</a>
        <% allSections.forEach((item) => { %>
          <a href="/<%= item.slug %>.html"><%= item.title %></a>
        <% }) %>
        <a href="/todays-picks.html">Today's Picks</a>
        <a href="/methodology.html">Methodology</a>
        <a href="/about.html">About</a>
        <a href="/contact.html">Contact</a>
        <a href="/privacy.html">Privacy</a>
        <a href="/terms.html">Terms</a>
      </div>
    </div>
  </footer>
</body>
</html>
