<% const ogImage = section.image.startsWith("http") ? section.image : `https://www.phavai.com${section.image}`; %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= section.metaTitle || `${section.title} Buying Guides | Phavai` %></title>
  <meta name="description" content="<%= section.metaDescription || section.description %>" />
  <meta name="robots" content="max-image-preview:large" />
  <link rel="canonical" href="https://www.phavai.com/<%= section.slug %>.html" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= section.metaTitle || `${section.title} Buying Guides | Phavai` %>" />
  <meta property="og:description" content="<%= section.description %>" />
  <meta property="og:image" content="<%= ogImage %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= section.metaTitle || `${section.title} Buying Guides | Phavai` %>" />
  <meta name="twitter:description" content="<%= section.description %>" />
  <meta name="twitter:image" content="<%= ogImage %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="/affiliate-tracking.js" defer></script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": section.metaTitle || `${section.title} Buying Guides | Phavai`,
    "description": section.description,
    "url": `https://www.phavai.com/${section.slug}.html`,
    "publisher": {
      "@type": "Organization",
      "@id": "https://www.phavai.com/#organization",
      "name": "Phavai",
      "url": "https://www.phavai.com/"
    },
    "hasPart": reviews.map((review) => ({
      "@type": "Article",
      "headline": review.title,
      "url": `https://www.phavai.com/${review.slug}.html`
    }))
  }, null, 2) %>
  </script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.phavai.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": section.title,
        "item": `https://www.phavai.com/${section.slug}.html`
      }
    ]
  }, null, 2) %>
  </script>
</head>
<body>
  <header class="site-header">
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href="/index.html"><span class="brand-mark">P</span> Phavai</a>
      <div class="nav-links">
        <% allSections.forEach((item) => { %>
          <a href="/<%= item.slug %>.html"><%= item.title %></a>
        <% }) %>
        <a href="/todays-picks.html">Today's Picks</a>
        <a class="hide-small" href="/methodology.html">Methodology</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="page-hero section-hero">
      <div class="wrap">
        <div class="page-grid">
          <div>
            <nav class="crumb" aria-label="Breadcrumb">
              <a href="/">Home</a><span aria-hidden="true">/</span>
              <span aria-current="page"><%= section.title %></span>
            </nav>
            <h1><%= section.title %> Buying Guides</h1>
            <p class="lede"><%= section.intro %></p>
            <div class="meta-row">
              <span class="meta-pill">Buyer-first picks</span>
              <span class="meta-pill"><%= reviews.length %> live buying guides</span>
              <span class="meta-pill">Retail links never buy rank</span>
            </div>
            <p class="review-byline">AI-assisted research · Human review by <a href="<%= editorialProfile.path %>"><%= editorialProfile.name %></a><% if (editorialProfile.expertiseSections.includes(section.slug)) { %>, <%= editorialProfile.outdoorByline %><% } %>. Phavai organizes selected reviews, recurring tradeoffs, and product facts; it does not imply first-hand testing. <a href="/methodology.html">See the process</a>.</p>
          </div>
          <% if (startingGuides.length) { %>
          <section class="collection-start-panel" aria-labelledby="collection-start-heading">
            <div class="section-kicker">Choose a starting point</div>
            <h2 id="collection-start-heading">What are you comparing?</h2>
            <p>Pick the guide closest to your actual purchase. The shortlist, tradeoffs, and retailer options live on the next page.</p>
            <div class="collection-start-links">
              <% startingGuides.forEach((review) => { %>
                <a href="/<%= review.slug %>.html" data-guide-link data-guide-placement="section-starting-point">
                  <span>Buying guide</span>
                  <strong><%= review.title %></strong>
                </a>
              <% }) %>
            </div>
          </section>
          <% } else { %>
            <div class="section-icon section-icon--<%= section.slug %>" aria-hidden="true"><%- section.iconSvg %></div>
          <% } %>
        </div>
        <nav class="page-jump-nav" aria-label="On this collection">
          <span>Browse this collection</span>
          <% reviewGroups.forEach((group) => { %><a href="#<%= group.id %>"><%= group.title %></a><% }) %>
          <% if (supportingPages.length) { %><a href="#shopping-advice">How to choose</a><% } %>
        </nav>
      </div>
    </section>

    <% reviewGroups.forEach((group, groupIndex) => { %>
      <section class="band<%= groupIndex % 2 ? ' surface' : '' %>" id="<%= group.id %>">
        <div class="wrap">
          <div class="section-head">
            <h2><%= group.title %></h2>
            <p><%= group.description %></p>
          </div>
          <div class="category-grid icon-card-grid">
            <% group.reviews.forEach((review) => { %>
              <a class="category-card category-card--<%= section.slug %>" href="/<%= review.slug %>.html" data-guide-link data-guide-placement="section-topic-group">
                <span class="card-icon" aria-hidden="true"><%- review.iconSvg %></span>
                <div class="category-card-body">
                  <span class="eyebrow">Buying guide</span>
                  <h3><%= review.title %></h3>
                  <p><%= review.description %></p>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      </section>
    <% }) %>

    <% if (relatedDataTools?.length) { %>
    <section class="band surface" id="data-lab-tools">
      <div class="wrap">
        <div class="section-head section-head--split">
          <div><span class="section-kicker">Phavai Data Lab</span><h2>Use the running research tools.</h2><p>Plan battery headroom, filter trail shoes by terrain and fit, or inspect normalized source data.</p></div>
          <a class="button secondary" href="/data-lab.html" data-guide-link data-guide-placement="section-data-lab">Open Data Lab</a>
        </div>
        <div class="data-tool-strip">
          <% relatedDataTools.forEach((tool) => { %><a href="<%= tool.url %>" data-guide-link data-guide-placement="section-data-tool"><span><%= tool.type %></span><strong><%= tool.title %></strong><small><%= tool.description %></small></a><% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (section.matters?.length) { %>
    <section class="band">
      <div class="wrap">
        <div class="section-head">
          <h2>What matters when you shop <%= section.title %>.</h2>
          <p>The best choice usually comes down to a few practical questions, not a spec sheet arms race.</p>
        </div>
        <div class="signal-grid">
          <% section.matters.forEach((item) => { %>
            <div class="signal">
              <b><%= item.heading %></b>
              <p><%= item.body %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (supportingPages.length) { %>
    <section class="band" id="shopping-advice">
      <div class="wrap">
        <div class="section-head">
          <h2><%= section.title %> shopping advice</h2>
          <p>Start here when you need to understand the decision before comparing individual products.</p>
        </div>
        <div class="category-grid">
          <% supportingPages.forEach((page) => { %>
            <a class="category-card category-card--<%= section.slug %>" href="/<%= page.slug %>.html" data-guide-link data-guide-placement="section-advice-grid">
              <div class="category-card-body">
                <span class="eyebrow"><%= page.type %></span>
                <h3><%= page.title %></h3>
                <p><%= page.description %></p>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div>AI-assisted product research. Human-reviewed. Sources linked.</div>
      <div>
        <a href="/index.html">Home</a>
        <% allSections.forEach((item) => { %>
          <a href="/<%= item.slug %>.html"><%= item.title %></a>
        <% }) %>
        <a href="/todays-picks.html">Today's Picks</a>
        <a href="/methodology.html">Methodology</a>
        <a href="/about.html">About</a>
        <a href="/contact.html">Contact</a>
        <a href="/privacy.html">Privacy</a>
        <a href="/terms.html">Terms</a>
      </div>
    </div>
  </footer>
</body>
</html>
